# Copy to .env and fill in. NEVER commit, share or paste .env into chats.

# ── ElevenLabs: transcription (Scribe), voice clone (TTS), voice isolation ──
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STS_MODEL=eleven_multilingual_sts_v2
# Safety net: at most this many TTS characters per run
MAX_TTS_CHARS_PER_RUN=6000

# ── AI generation for `npm run generate` – set up one or more, pick with --provider ──
# Default provider for image/video (fal | bfl | higgsfield | atlas); audio defaults to elevenlabs
GEN_PROVIDER=fal

# fal.ai: one key, many image/video/audio models
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/dev
# e.g. a Kling, Veo or Seedance endpoint from fal.ai/models
FAL_VIDEO_MODEL=
# e.g. a sound or music endpoint from fal.ai/models (for --type audio --provider fal)
FAL_AUDIO_MODEL=

# Black Forest Labs (FLUX images, dashboard.bfl.ai). Models: flux-2-pro, flux-2-max, flux-2-flex, flux-pro-1.1-ultra, flux-kontext-pro …
BFL_API_KEY=
BFL_IMAGE_MODEL=flux-2-pro
# EU-only processing: https://api.eu.bfl.ai
BFL_API_BASE=

# Higgsfield (console.higgsfield.ai) – enter the key as <key id>:<key secret>.
# Models are paths from docs.higgsfield.ai, e.g. higgsfield-ai/soul/standard (image); video: see the model page
HIGGSFIELD_API_KEY=
HIGGSFIELD_IMAGE_MODEL=higgsfield-ai/soul/standard
HIGGSFIELD_VIDEO_MODEL=

# Atlas Cloud (atlascloud.ai) – many image/video models behind one key. Model IDs from the model pages
ATLAS_API_KEY=
ATLAS_IMAGE_MODEL=
ATLAS_VIDEO_MODEL=

# ── Remotion license: free for individuals and companies with up to 3 people.
#    Companies with 4+ people need a paid Company License (remotion.pro/license). ──
REMOTION_LICENSE_KEY=

# Only set if Remotion should use a specific browser (otherwise leave empty)
REMOTION_BROWSER_EXECUTABLE=

# ── Photo/video search for `npm run visuals -- <slug> --search` (optional; Wikimedia Commons and Openverse need no key) ──
PEXELS_API_KEY=
PIXABAY_API_KEY=
# unsplash.com/developers → Your apps → Access Key
UNSPLASH_ACCESS_KEY=
# Coverr: free stock videos + music (ask team@coverr.co for a key; demo keys require a credit for Coverr)
COVERR_API_KEY=

# ── Upscaling small photos with `npm run upscale` (Magnific Precision, formerly Freepik API – costs money) ──
MAGNIFIC_API_KEY=
# Older Freepik accounts: https://api.freepik.com
MAGNIFIC_API_BASE=

# ── Sound/music search for `npm run sounds` (optional; Openverse needs no key) ──
# freesound.org/apiv2/apply → API key
FREESOUND_API_KEY=
